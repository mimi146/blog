{
  "name": "blog",
  "version": "0.1.0",
  "description": "Milan Niroula's blog: research notes on AI, software engineering, design, and systems at scale.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "images": "node scripts/generate-images.mjs",
    "setup:browser": "playwright install chromium",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Milan Niroula",
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "unist-util-visit": "^5.2.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
