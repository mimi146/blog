---
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { SITE } from '../consts';
import { absoluteUrl, formatDate, postPath, readingTime, withBase, type Post } from '../lib/utils';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
  headings?: { depth: number; slug: string; text: string }[];
}
const { post, prev, next, headings = [] } = Astro.props;

// Build a table of contents from Astro's rendered headings (h2/h3 only).
// Astro slugs are github-slugger based — identical to the ids rehype-slug writes — so a
// pure "#<slug>" fragment resolves to the heading id already in the built HTML.
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocItems.length >= 2;
const { title, description, pubDate, updatedDate, tags, heroImage, heroAlt } = post.data;

// Social image: the hero image (cropped to 1200x630 PNG) if present, otherwise the site default.
let ogImage: string = SITE.ogImage;
let ogImageAlt: string = SITE.ogImageAlt;
if (heroImage) {
  const og = await getImage({ src: heroImage, width: 1200, height: 630, format: 'png', fit: 'cover' });
  ogImage = og.src;
  ogImageAlt = heroAlt ?? title;
}

const url = absoluteUrl(postPath(post), Astro.site);
const homeUrl = absoluteUrl('/', Astro.site);
const article = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: title,
  description,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', '@id': `${homeUrl}#person`, name: SITE.author, url: absoluteUrl('/about/', Astro.site) },
  publisher: { '@id': `${homeUrl}#person` },
  isPartOf: { '@id': `${homeUrl}#website` },
  image: absoluteUrl(ogImage, Astro.site),
  keywords: tags.join(', '),
  inLanguage: SITE.lang,
  wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={ogImage}
  imageAlt={ogImageAlt}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
  jsonLd={[article]}
>
  <div class="reading-progress" aria-hidden="true" data-pagefind-ignore>
    <div class="reading-progress__bar"></div>
  </div>

  <article data-pagefind-body>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta">
        <span>
          Published <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </span>
        {
          updatedDate && (
            <span>
              Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
        <span>{readingTime(post.body)} min read</span>
      </div>
      <TagList tags={tags} />
    </header>

    {
      heroImage && (
        <figure class="hero">
          <Image src={heroImage} alt={heroAlt ?? ''} widths={[680, 1024, 1360]} sizes="(max-width: 760px) 100vw, 680px" loading="eager" fetchpriority="high" />
        </figure>
      )
    }

    {
      showToc && (
        <nav class="toc" aria-label="Table of contents" data-pagefind-ignore>
          <p class="toc-title">On this page</p>
          <ul>
            {tocItems.map((h) => (
              <li class={h.depth === 3 ? 'toc-sub' : undefined}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose">
      <slot />
    </div>
  </article>

  <footer class="post-footer" data-pagefind-ignore>
    <p>
      Thanks for reading. Follow along via <a href={withBase('/rss.xml')}>RSS</a> or browse <a href={withBase('/tags/')}>all tags</a>.
    </p>
    {
      (prev || next) && (
        <nav class="post-nav" aria-label="More posts">
          {prev && (
            <a href={withBase(postPath(prev))} rel="prev">
              <small>Older</small>
              {prev.data.title}
            </a>
          )}
          {next && (
            <a class="next" href={withBase(postPath(next))} rel="next">
              <small>Newer</small>
              {next.data.title}
            </a>
          )}
        </nav>
      )
    }
  </footer>

  <script is:inline>
    // Copy-to-clipboard buttons for Shiki code blocks. Injected client-side so the
    // button never enters the built HTML that Pagefind reads. Vanilla IIFE, resilient
    // if elements are absent; only touches <pre> inside .prose, never inline code.
    (function () {
      function init() {
        if (!document.body) return;
        var canCopy = !!(navigator.clipboard && navigator.clipboard.writeText);
        if (!canCopy) return; // graceful no-op: never render a button that cannot work
        var blocks = document.querySelectorAll('.prose pre');
        for (var i = 0; i < blocks.length; i++) {
          (function (pre) {
            // Belt-and-suspenders: Mermaid renders as figure.mermaid-diagram (no <pre>),
            // but defensively skip anything that is, or lives inside, a Mermaid node.
            if (pre.classList.contains('mermaid')) return;
            if (pre.closest && pre.closest('.mermaid-diagram')) return;

            var wrapper = document.createElement('div');
            wrapper.className = 'code-block';
            var parent = pre.parentNode;
            if (!parent) return;
            parent.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);

            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'copy-btn';
            btn.setAttribute('aria-label', 'Copy code');
            btn.textContent = 'Copy';
            wrapper.appendChild(btn);

            var revert;
            btn.addEventListener('click', function () {
              var codeEl = pre.querySelector('code');
              var text = codeEl ? codeEl.textContent : pre.textContent;
              try {
                navigator.clipboard.writeText(text || '').then(function () {
                  btn.setAttribute('data-copied', '');
                  btn.setAttribute('aria-label', 'Copied');
                  btn.textContent = 'Copied';
                  if (revert) clearTimeout(revert);
                  revert = setTimeout(function () {
                    btn.removeAttribute('data-copied');
                    btn.setAttribute('aria-label', 'Copy code');
                    btn.textContent = 'Copy';
                  }, 2000);
                }, function () {});
              } catch (e) {}
            });
          })(blocks[i]);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>

  <script is:inline>
    // Reading-progress bar reflecting scroll through the article. Vanilla IIFE,
    // rAF-throttled, resilient if the elements are absent.
    (function () {
      function init() {
        var bar = document.querySelector('.reading-progress__bar');
        var article = document.querySelector('article[data-pagefind-body]') || document.querySelector('article');
        if (!bar || !article) return;
        var ticking = false;
        function update() {
          ticking = false;
          var rect = article.getBoundingClientRect();
          var viewport = window.innerHeight || document.documentElement.clientHeight;
          // Distance scrolled past the article top, over the scrollable span of the article.
          var total = rect.height - viewport;
          var progress = total > 0 ? (-rect.top) / total : (rect.top <= 0 ? 1 : 0);
          if (progress < 0) progress = 0;
          if (progress > 1) progress = 1;
          bar.style.transform = 'scaleX(' + progress + ')';
        }
        function onScroll() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(update);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>
