---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RegexTester from '../../components/tools/RegexTester';
import { ARTICLES } from '../../lib/tools/articles';
import { getTool, relatedTools } from '../../lib/tools/catalog';
import { articleHtml } from '../../lib/tools/html';

const tool = getTool('regex-tester');
---

<ToolLayout title={tool.h1} description={tool.description} lede={tool.lede} related={relatedTools(tool.slug)} applicationCategory={tool.applicationCategory}>
  <RegexTester client:visible slot="tool" />
  <div slot="copy" set:html={articleHtml(ARTICLES[tool.slug])} />
</ToolLayout>
