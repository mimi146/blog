---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/utils';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist." noindex>
  <h1>Page not found</h1>
  <p class="lede">That page doesn’t exist (or moved).</p>
  <p>Try the <a href={withBase('/')}>home page</a>, <a href={withBase('/posts/')}>all posts</a>, or <a href={withBase('/search/')}>search</a>.</p>
</BaseLayout>
